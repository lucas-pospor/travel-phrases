# Keys used only by `npm run audio` on your machine. They are never bundled
# into the app. Copy this file to .env and fill in ONE of them.

# OpenAI text-to-speech (gpt-4o-mini-tts). Used when set.
OPENAI_API_KEY=

# Google Cloud Text-to-Speech. Used when OPENAI_API_KEY is empty.
GOOGLE_TTS_API_KEY=
